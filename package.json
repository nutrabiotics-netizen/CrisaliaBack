    "@aws-sdk/client-transcribe-streaming": "^3.986.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "openai": "^6.15.0",
    "pdfkit": "^0.15.0",
